# Copy to .env and replace placeholders with unique random values.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
LEADSRAT_API_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_API_KEY

# Bootstrap organization admin identity
LEADSRAT_ADMIN_EMAIL=admin@parkzone.in
# Initial admin password; use a unique random value of at least 20 characters
LEADSRAT_ADMIN_PASSWORD=replace-with-a-unique-random-password
